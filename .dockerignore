# Những thứ KHÔNG được copy vào image.
# Image chỉ cần: app/, utils/, requirements.txt — đừng ignore các mục đó.

# Secret — lọt vào image là lọt lên registry
.env
.env.*
!.env.example
*.pem
*.key

# Git & môi trường ảo
.git
.gitignore
.github
.venv
venv
env

# Python cache
__pycache__
*.py[cod]
.pytest_cache

# Thứ không cần lúc chạy
tests
screenshots
nginx
*.md
docker-compose*.yml
Dockerfile*
.dockerignore
render.yaml
railway.toml
grade.py
.idea
.vscode
.DS_Store
*.log
